<!-- <?xml version="1.0" encoding="UTF-8"?> -->





<sdf version='1.6'>
	<model name="minidrone">
		<link name="base_link">
			<pose>0 0 0 0 0 0</pose>

			<!-- Body physics {-->
			<inertial>
				<mass>1.0</mass>
				<inertia>
					<ixx>0.03166666666666667</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>0.03166666666666667</iyy>
					<iyz>0</iyz>
					<izz>0.0625</izz>
				</inertia>
			</inertial>
			<collision name="base_link_collision">
				<pose>0 0 -0.03 0 0 0</pose>
				<geometry>
					<cylinder>
						<length>0.1</length>
						<radius>0.1</radius>
					</cylinder>
				</geometry>
				<surface>
					<contact>
						<ode>
							<min_depth>0.001</min_depth>
							<max_vel>0.0</max_vel>
						</ode>
					</contact>
					<friction>
						<ode/>
					</friction>
				</surface>
			</collision>
			<!--}-->

			<!-- Body visuals {-->

			<!-- Quadcopter {-->
			<visual name="quadcopter">
				<pose>0 0 0 0 0 0</pose>
				<geometry>
					<mesh>
						<uri>model://minidrone/meshes/drone/Quadcopter.dae</uri>
						<scale>1 1 1</scale>
					</mesh>
				</geometry>
			</visual>
			<!--}-->

      <gravity>1</gravity>
			<velocity_decay/>
		</link>
		<!--}-->

		<!-- IMU {-->
		<link name='imu_link'>
			<pose>0 0 0.02 0 0 0</pose>
			<inertial>
				<pose>0 0 0 0 0 0</pose>
				<mass>0.015</mass>
				<inertia>
					<ixx>1e-05</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>1e-05</iyy>
					<iyz>0</iyz>
					<izz>1e-05</izz>
				</inertia>
			</inertial>
			<sensor name="uav1_imu" type="imu">
				<always_on>true</always_on>
				<update_rate>200</update_rate>
				<visualize>true</visualize>
				<plugin name="uav1_imu_gazebo_ros_imu_sensor" filename="libgazebo_ros_imu_sensor.so">
					<ros>
						<remapping>~/out:=/uav1/imu/data</remapping>
					</ros>
					<body_name>imu_link</body_name>
					<gaussian_noise>0.0</gaussian_noise>
					<xyz_offset>0 0 0</xyz_offset>
					<rpy_offset>0 0 0</rpy_offset>
					<frame_name>imu_link</frame_name>
					<initial_orientation_as_reference>false</initial_orientation_as_reference>
				</plugin>
			</sensor>
		</link>
		<joint name='imu_joint' type='revolute'>
			<child>imu_link</child>
			<parent>base_link</parent>
			<axis>
				<xyz>1 0 0</xyz>
				<limit>
					<lower>0</lower>
					<upper>0</upper>
					<effort>0</effort>
					<velocity>0</velocity>
				</limit>
				<dynamics>
					<spring_reference>0</spring_reference>
					<spring_stiffness>0</spring_stiffness>
				</dynamics>
				<use_parent_model_frame>1</use_parent_model_frame>
			</axis>
		</joint>
		<!--}-->

		<!-- Propellers {-->
		<link name="prop_0_link">
			<gravity>1</gravity>
			<velocity_decay/>
			<pose>0.1812 -0.1812 0.057 0 0 0</pose>
			<inertial>
				<mass>0.005</mass>
				<inertia>
					<ixx>0.0001</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>0.0001</iyy>
					<iyz>0</iyz>
					<izz>0.0001</izz>
				</inertia>
			</inertial>
			<visual name="prop_0_visual_1">
				<geometry>
					<mesh>
						<uri>model://x500/meshes/x500v2/prop_mesh_file.dae</uri>
						<scale>1 1 1</scale>
					</mesh>
				</geometry>
			</visual>
			<visual name="prop_0_visual_2">
				<pose>0 0 -0.0086 0 0 0</pose>
				<geometry>
					<mesh>
						<uri>model://x500/meshes/x500v2/motor_top_mesh_file.stl</uri>
						<scale>1 1 1</scale>
					</mesh>
				</geometry>
				<material>					<!-- GREY -->
					<script>
						<name>Gazebo/Grey</name>
						<uri>file://media/materials/scripts/gazebo.material</uri>
					</script>
				</material>
			</visual>
			<collision name="prop_0_link_collision">
				<pose>0 0 0 0 1.5707963267950003 0</pose>
				<geometry>
					<cylinder>
						<length>0.3302</length>
						<radius>0.01</radius>
					</cylinder>
				</geometry>
				<surface>
					<contact>
						<ode/>
					</contact>
					<friction>
						<ode/>
					</friction>
				</surface>
			</collision>
		</link>
		<joint name="prop_0_joint" type="revolute">
			<parent>base_link</parent>
			<child>prop_0_link</child>
			<axis>
				<xyz>0 0 1</xyz>
				<limit>
					<lower>-1e+16</lower>
					<upper>1e+16</upper>
				</limit>
				<dynamics>
					<spring_reference>0</spring_reference>
					<spring_stiffness>0</spring_stiffness>
				</dynamics>
				<use_parent_model_frame>1</use_parent_model_frame>
			</axis>
		</joint>

