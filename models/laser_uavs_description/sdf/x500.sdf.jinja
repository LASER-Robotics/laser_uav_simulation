      load_z_offset=load_z_offset)
    }}
    {% endif %}
    {# <!--}--> #}
  
    {# load ground truth {--> #}
    {% if enable_ground_truth and (enable_hollow_load_pendulum or enable_load_pendulum) %}
    {{ components.gazebo_ground_truth_macro(
      namespace = namespace,
      odometry_sensor_name = 'load_ground_truth',
      parent_link = 'load_link',
      topic_name = 'load_ground_truth',
      noise = 0,
      frame_name = 'world',
      update_rate = 100,
      x = 0,
      y = 0,
      z = 0,
      roll = 0,
      pitch = 0,
      yaw = 0,
      x_offset = load_x_offset,
      y_offset = load_y_offset,
      z_offset = load_z_offset,
      roll_offset = roll_offset,
      pitch_offset = pitch_offset,
      yaw_offset = yaw_offset)
    }}
    {% endif %}
    {# <!--}--> #}

    {# ball_load {--> #}
    {% if enable_hollow_load_pendulum %}
      {% set poses = [ball] %}

      {% for i in range(poses | length) %}
        {% for j in range(1) %}
        {{ components.spawn_passive_ball(
            name='ball_passiva_' ~ i ~ '_' ~ j, 
            pose=poses[i],
            mass=0.2,
            radius=0.02)
        }}
        {% endfor %} 
      {% endfor %}
    {% endif %}
    {# <!--}--> #}
  </model>
