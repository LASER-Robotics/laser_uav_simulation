      namespace = namespace,
      parent_link = root,
      sensor_name = 'livox_up',
      rot_freq = 10,
      noise = 0.01,
      max_range = 40,
      x = 0.0,
      y = 0.0,
      z = 0.1,
      roll = 0,
      pitch = 0.0,
      yaw = 0,
      lasers = 20)
    }} 

    {{ components.imu_sensor_macro(
      namespace = namespace,
      sensor_name = 'livox_up_imu',
      parent_link = 'livox_up',
      topic_name = namespace + '/livox_up/imu',
      update_rate = 200,
      x = 0,
      y = 0,
      z = 0,
      roll = 0.0,
      pitch = 0.0,
      yaw = 0.0)
    }}
    {% endif %}
    {# <!--}--> #}

    {# livox_45 {--> #}
    {% if enable_livox_45 %}
    {{ components.livox_lidar_macro(
