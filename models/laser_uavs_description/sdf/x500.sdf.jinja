    {# ========================== research itens ======================== #}

    {# load_pendulum {--> #}
    {% if enable_load_pendulum %}
    {{ components.load_pendulum(
      name='load_attacher',
      parent_link='base_link',
      attach_linker_pose='0 0 -0.01 0 0 0',
      attach_linker_mass=0.01,
      rope_num_segments=20,
      rope_segment_length=0.03,
      rope_segment_radius=0.002,
      rope_segment_mass=0.001,
      load_mass=0.1,
      load_x_offset=load_x_offset,
      load_y_offset=load_y_offset,
      load_z_offset=load_z_offset)
    }}
    {% endif %}
