      parent_link = root,
      realistic = 1,
      update_rate = 60,
      x = 0.0,
      y = 0.0,
      z = 0.15,
      roll = 0,
      pitch = 0,
      yaw = 0)
    }}

    {{ components.imu_sensor_macro(
      namespace = namespace,
      sensor_name = 'front_rgbd_imu',
      parent_link = 'front_rgbd',
      topic_name = namespace + '/front_rgbd/imu/data',
      update_rate = 200,
      x = 0,
      y = 0,
      z = 0,
      roll = -1.5708,
      pitch = 0,
      yaw = -1.5708)
    }}
    {% endif %}
    {# <!--}--> #}

    {# realsense down {--> #}
    {% if enable_d435_down %}
    {{ components.realsense_d435_macro(
      namespace = namespace,
      camera_name = 'down_rgbd', camera_suffix='',
      parent_link = root,
      realistic = 1,
      update_rate = 60,
      x = 0.065,
