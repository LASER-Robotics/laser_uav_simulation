    {# <!--}--> #}

    {# ========================== VIO sensors ======================== #}

    {# VIO (classic) {--> #}
    {% if enable_vio %}
    {{ components.vio_macro(
      namespace = namespace,
      sensor_name = 'vio',
      parent_link = root,
      camera_rate = 120,
      imu_rate = 200,
      x = 0.095,
      y = 0,
      z = -0.025,
      roll = 0,
      pitch = 0,
      yaw = 0)
    }}
    {% endif %}
