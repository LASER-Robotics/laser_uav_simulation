    }}
    {% endif %}
    {# <!--}--> #}

    {# livox_down {--> #}
    {% if enable_livox_down %}
    {{ components.livox_lidar_macro(
      namespace = namespace,
      parent_link = root,
      sensor_name = 'livox_down',
      rot_freq = 15,
      noise = 0.01,
      max_range = 40,
      x = -0.05,
      y = 0.0,
      z = -0.05,
      roll = 3.141592,
      pitch = 0.785398,
      yaw = 0,
      lasers = 20)
    }} 

    {{ components.imu_sensor_macro(
      namespace = namespace,
      sensor_name = 'livox_down_imu',
      parent_link = 'livox_down',
      topic_name = namespace + '/livox_down/imu',
      update_rate = 200,
      x = 0.00,
      y = 0.0,
      z = 0.00,
      roll = 0.0,
      pitch = 0.0,
      yaw = 0.0)
