<?xml version="1.0" encoding="UTF-8"?>

<sdf version="1.6">

  {% import "component_snippets.sdf.jinja" as components %}

  <model name="payload">

    {# payload_box {--> #}
    {{ components.payload_box_macro(
      name='box_link',
      mass=1.0,
      size_x=0.1,
      size_y=0.1,
      size_z=0.1,
      attachment_distance=0.05,
      center_connections=true)
    }}
    {# <!--}--> #}

    {# ground_truth {--> #}
    {% if enable_ground_truth %}
    <!-- Measure the actual force body; no extra sensor-link mass or offset. -->
    <plugin name="{{ namespace }}_ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/{{ namespace }}</namespace>
        <remapping>odom:=ground_truth</remapping>
      </ros>
      <body_name>box_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>100.0</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
    {% endif %}
    {# <!--}--> #}

    {# payload_connection {--> #}
    <plugin
      name="payload_connection_plugin"
      filename="libpayload_connection_plugin.so">

      <uav1_model>uav3_lr7pro_2</uav1_model>
      <uav2_model>uav5_lr7pro_4</uav2_model>

      <!-- Center geometry and cable law match unified_world. -->
      <training_center_model>true</training_center_model>
      <rope_length>1.0</rope_length>

      <stiffness>200.0</stiffness>
      <damping>60.0</damping>
      <max_force>50.0</max_force>

      <tension_topic>/payload/rope_tension</tension_topic>
      <tension_update_rate>30.0</tension_update_rate>

      <visual_segments>20</visual_segments>
      <visual_radius>0.004</visual_radius>
      <visual_update_rate>20.0</visual_update_rate>

    </plugin>
    {# <!--}--> #}

  </model>

</sdf>
