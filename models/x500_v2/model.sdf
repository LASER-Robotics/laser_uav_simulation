			    <specular>0.01 0.01 0.01 1</specular>
		    </material>
		  </visual>
      <!--}-->
      
      <!-- gps mount and gps {-->
		  <visual name="gps_mount_visual">
		    <pose>0 0 0 0 0 1.5707963267950003</pose>
		    <geometry>
			    <mesh>
			      <uri>model://x500_v2/meshes/x500v2/gps_mount_mesh_file.stl</uri>
			      <scale>1 1 1</scale>
			    </mesh>
		    </geometry>
		    <material> <!-- GREY -->
			    <ambient>.3 .3 .3  1</ambient>
			    <diffuse>.7 .7 .7  1</diffuse>
			    <specular>0.01 0.01 0.01 1</specular>
		    </material>
		  </visual>
		  <visual name="gps_module_visual">
		    <pose>0 0 0 0 0 1.5707963267950003</pose>
		    <geometry>
			    <mesh>
			      <uri>model://x500_v2/meshes/x500v2/gps_module_mesh_file.stl</uri>
			      <scale>1 1 1</scale>
			    </mesh>
		    </geometry>
		    <material> <!-- BLACK -->
			    <ambient>0 0 0 1</ambient>
			    <diffuse>0 0 0 1</diffuse>
			    <specular>0.1 0.1 0.1 1 </specular>
		    </material>
		  </visual>
      <!--}-->
      
      <!-- rplidar mount {-->
		  <visual name="garmin_mount_visual">
		    <pose>0 0 0.001 0 0 1.5707963267950003</pose>
		    <geometry>
			    <mesh>
			      <uri>model://x500_v2/meshes/x500v2/garmin_mount_mesh_file.stl</uri>
